# URL de Conexão com o Banco de Dados (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@db:5432/catadores

# Configurações de Segurança e JWT
SECRET_KEY=sua_chave_secreta_super_segura_para_geracao_de_tokens
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Monitoramento (Opcional)
SENTRY_DSN=

# Origens permitidas no CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,https://redes-catadores-ceara.vercel.app
